# Lua build under Gramine-SGX: make, gcc 15.2.0 (native build of the same
# source as TriSeal's), cc1, as, ld, ar and ranlib, each process in its own
# enclave. Generated by e2e/lua-gramine.sh.

libos.entrypoint = "{{ make }}"
loader.log_level = "error"
loader.insecure__use_cmdline_argv = true
loader.env.LD_LIBRARY_PATH = "/lib:/usr/lib/x86_64-linux-gnu:/lib/x86_64-linux-gnu"
loader.env.PATH = "/usr/bin:/bin"
loader.env.TMPDIR = "{{ work }}/tmp"

fs.start_dir = "{{ work }}"
fs.mounts = [
  { path = "/lib", uri = "file:{{ gramine.runtimedir() }}" },
  { path = "/usr/lib/x86_64-linux-gnu", uri = "file:/usr/lib/x86_64-linux-gnu" },
  { path = "/usr/bin", uri = "file:/usr/bin" },
  { path = "{{ root }}", uri = "file:{{ root }}" },
  { path = "{{ gcc }}", uri = "file:{{ gcc }}" },
{% if mode == "encrypted" %}
  { type = "encrypted", path = "{{ work }}", uri = "file:{{ work }}", key_name = "bench" },
{% else %}
  { path = "{{ work }}", uri = "file:{{ work }}" },
{% endif %}
]

{% if mode == "encrypted" %}
# Benchmark-only key; the same 16 bytes as wrap.key, used to pre-encrypt the sources.
fs.insecure__keys.bench = "00112233445566778899aabbccddeeff"
{% else %}
sgx.allowed_files = [ "file:{{ work }}/" ]
{% endif %}

sgx.debug = true
sgx.edmm_enable = {{ edmm }}
sgx.enable_stats = {{ stats }}
sgx.enclave_size = "{{ enclave_size }}"
sgx.max_threads = 8

sgx.trusted_files = [
  "file:{{ gramine.libos }}",
  "file:{{ gramine.runtimedir() }}/",
  "file:{{ gcc }}/",
{% for f in trusted.split(",") %}
  "file:{{ f }}",
{% endfor %}
]
