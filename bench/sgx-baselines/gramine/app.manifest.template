# Gramine manifest shared by all benchmark binaries.
# Build with: make APP=<name> (see Makefile).

libos.entrypoint = "/app/{{ app }}"
loader.log_level = "{{ log_level }}"
loader.env.LD_LIBRARY_PATH = "/lib"
# Benchmarks take their iteration counts on the command line.
loader.insecure__use_cmdline_argv = true

fs.start_dir = "/app"
fs.mounts = [
  { path = "/lib", uri = "file:{{ gramine.runtimedir() }}" },
  { path = "/app", uri = "file:app" },
  # In-enclave memory, like TriSeal's imfs and Occlum's ramfs /tmp.
  { type = "tmpfs", path = "/tmp" },
]

sgx.debug = true
sgx.enable_stats = {{ 'true' if env.get('STATS', '0') == '1' else 'false' }}
sgx.edmm_enable = {{ 'true' if env.get('EDMM', '0') == '1' else 'false' }}
sgx.enclave_size = "{{ env.get('ENCLAVE_SIZE', '1G') }}"
sgx.max_threads = {{ env.get('MAX_THREADS', '8') }}

sgx.trusted_files = [
  "file:{{ gramine.libos }}",
  "file:{{ gramine.runtimedir() }}/",
  "file:app/",
]
